# ==============================================================================
# AETHER REALTIME PLATFORM — CONFIGURAÇÃO DE PRODUÇÃO & NUVEM GRATUITA 24/7
# ==============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3001

# Domínio oficial HTTPS (usado pelo Caddy para TLS automático Let's Encrypt / ZeroSSL)
PUBLIC_DOMAIN=aether.seudominio.com
PUBLIC_URL=https://aether.seudominio.com

# ------------------------------------------------------------------------------
# SEGREDOS CRIPTOGRÁFICOS DE SEGURANÇA (Gere com: openssl rand -hex 48)
# ------------------------------------------------------------------------------
# Assinatura de Access Tokens (curta duração: 15 min em RAM) e Refresh Tokens
JWT_ACCESS_SECRET=troque_por_chave_aleatoria_segura_de_96_hex_caracteres_1
JWT_REFRESH_SECRET=troque_por_chave_aleatoria_segura_de_96_hex_caracteres_2

# Pepper criptográfico de servidor combinado via HMAC-SHA256 antes do scrypt (N=32768, salt 256-bit)
PASSWORD_PEPPER=troque_por_pepper_exclusivo_do_servidor_de_96_hex_caracteres

# Chave mestra para criptografia autenticada AES-256-GCM de dados sensíveis em repouso (ex.: e-mail)
DATA_ENCRYPTION_KEY=troque_por_chave_mestra_aes256gcm_de_96_hex_caracteres

# ------------------------------------------------------------------------------
# BANCO DE DADOS RELACIONAL (Neon.tech Free PostgreSQL Serverless OU Container Local)
# ------------------------------------------------------------------------------
# Opção A (Recomendado p/ Nuvem 100% Gratuita — Neon.tech Free / Supabase Free):
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.sa-east-1.aws.neon.tech/aether?sslmode=require
# DATABASE_SSL=true
#
# Opção B (PostgreSQL auto-hospedado via docker-compose.production.yml):
POSTGRES_USER=aether
POSTGRES_PASSWORD=troque_por_senha_forte_postgres
POSTGRES_DB=aether
DATABASE_URL=postgresql://aether:troque_por_senha_forte_postgres@postgres:5432/aether
DATABASE_SSL=false

# Barramento Cluster Multi-Nó (Redis Pub/Sub — Upstash Free ou Container Redis Local)
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# CLUSTER MEDIA SFU (mediasoup C++ Workers — Voz + Live 720p/1080p/1440p @ 30/60/75 FPS)
# ------------------------------------------------------------------------------
# OBRIGATÓRIO NA NUVEM: IPv4 público da instância (ex.: Oracle Cloud Always Free VM, Hetzner, AWS, Fly.io)
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=203.0.113.10
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40400
MEDIASOUP_WORKERS=4

# ------------------------------------------------------------------------------
# SERVIDORES STUN / TURN (Travessia NAT Simétrica/Corporativa via coturn HMAC RFC 5389)
# ------------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:aether.seudominio.com:3478
TURN_URLS=turn:aether.seudominio.com:3478?transport=udp,turn:aether.seudominio.com:3478?transport=tcp
TURN_STATIC_AUTH_SECRET=troque_por_segredo_hmac_compartilhado_com_coturn

# ------------------------------------------------------------------------------
# ARMAZENAMENTO S3 / CLOUDFLARE R2 GRATUITO (10 GB Free c/ Egress Zero)
# ------------------------------------------------------------------------------
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# URL pública opcional para download direto do instalador Windows (ex.: GitHub Releases ou Cloudflare R2)
DESKTOP_INSTALLER_URL=
