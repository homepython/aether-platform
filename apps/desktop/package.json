{
  "name": "@aether/desktop",
  "version": "1.0.0",
  "description": "Aether — Plataforma Premium de Voz, Chat e Transmissão em Tempo Real",
  "author": "Aether Technologies",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-renderer.mjs",
    "dev": "tsc -p tsconfig.json && electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "electronVersion": "34.5.8",
    "appId": "com.aether.realtime",
    "productName": "Aether",
    "copyright": "Copyright © 2026 Aether Realtime Systems",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../../release/desktop",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron/**/*",
      "renderer/**/*",
      "overlay/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "Aether-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Aether",
      "uninstallDisplayName": "Aether Realtime",
      "deleteAppDataOnUninstall": false
    }
  }
}
